# Copy this file to .env and replace the placeholder with a private random value.
# Generate one in PowerShell with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=sqlite:///./mindspeak.db

# Gmail SMTP for registration verification and password reset.
# Use a dedicated test Gmail account with 2-Step Verification enabled.
# Create a Google App Password; do not put your normal Gmail password here.
# Replace every example value. Remove spaces from the 16-character app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-test-account@gmail.com
SMTP_PASSWORD=replace-with-google-app-password
SMTP_FROM_EMAIL=your-test-account@gmail.com
SMTP_USE_STARTTLS=true
