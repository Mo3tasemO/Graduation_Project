# Copy this file to ".env" (same folder) and fill it in. NEVER commit .env

PORT=4000

# ---- Sender account: sends codes to Gmail, Hotmail, Yahoo and other inboxes ----
# These are the app's sender credentials, not each user's email credentials.
# Gmail SMTP example; another SMTP provider can be configured using its host/port.
# 1) Use a Gmail account that has 2-Step Verification turned on
# 2) Create an "App password": https://myaccount.google.com/apppasswords
# 3) Paste the 16-character app password below (NOT your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: omit to use MindSpeak <SMTP_USER>
# MAIL_FROM=MindSpeak <yourproject@gmail.com>

# Real email mode. Delivery errors are shown instead of exposing codes in the app.
# Use true ONLY for local development without email delivery.
DEV_SHOW_CODE=false

# Optional: choose your own admin key (otherwise one is generated in data/admin.key)
# ADMIN_KEY=change-me
